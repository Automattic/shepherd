{
  "name": "shepherd",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Live dashboard of the team's open pull requests on GitHub and GitHub Enterprise, with an MCP server for agents",
  "type": "module",
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && bun build web/app.ts --target=browser --outdir=.check-build >/dev/null && rm -rf .check-build"
  },
  "engines": {
    "bun": ">=1.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  }
}
